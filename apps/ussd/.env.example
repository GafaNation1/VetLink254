# apps/ussd/.env.example — Environment variable template for VetLink254 USSD thin adapter
# These match docker-compose.yml's ussd service `environment` block (which takes precedence).
# Values use docker-internal service names because the adapter runs inside the compose network.
API_BASE_URL=http://api:8000
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=180
