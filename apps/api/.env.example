# apps/api/.env.example — Environment variable template for VetLink254 Core API
# NOTE: this file is the TEMPLATE ONLY. Real values (secrets, credentials, URLs) are supplied via
# the deployment environment (docker-compose for local dev, Render service environment for deploy)
# and are NEVER committed. See docs/CURRENT_STATE.md for what is live vs code-complete vs stub.
DATABASE_URL=postgresql://vetlink:vetlink_pass@postgres:5432/vetlink254
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development
# JWT signing secret. MUST be a long random value in production (Render secret env var).
SECRET_KEY=dev-secret-key-change-in-prod-0123456789abcdef

# Minimal real auth (PART 3): one admin user seeded from these env vars by scripts/create_admin.py
# (run automatically by the docker-compose api start command and the Render release command).
# ADMIN_PASSWORD here is a LOCAL-DEMO placeholder — production MUST set a real value via Render.
ADMIN_EMAIL=admin@vetlink254.local
ADMIN_PASSWORD=dev-admin-password-change-me
# JWT lifetime in minutes (default 1440 = 24h). No refresh tokens (documented MVP decision).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS for the apps/web dashboard. Dev default "*"; comma-separated allow-list in production.
CORS_ORIGINS=*

# KVB (Kenya Veterinary Board) license-verification bridge.
# VetLink254 is NOT the source of truth on who is a licensed vet — KVB is. We call OUT to KVB's
# system (MMS, mms.kenyavetboard.or.ke) once they expose a public API. Until then the client runs in
# TEMPORARY STUB MODE (KVB_API_BASE_URL unset or "stub"): it returns canned data and logs a WARNING.
# To go live: set KVB_API_BASE_URL to the real endpoint + real credentials — no other code changes.
KVB_API_BASE_URL=stub
# Dev placeholders ONLY — replace with real KVB OAuth2 client-credentials in production.
KVB_CLIENT_ID=kvb-dev-client-id
KVB_CLIENT_SECRET=kvb-dev-client-secret
# Per-session Redis cache TTL for successful lookups (matches the 180s USSD session TTL); <=0 disables.
KVB_CACHE_TTL_SECONDS=180

# Africa's Talking SMS (notifications), via the official africastalking SDK (pinned 2.0.3).
# SMSClient runs in STUB/no-op mode (logs a WARNING, sends nothing) until AT_USERNAME + AT_API_KEY
# are set — a missing SMS config must never break the booking/verify flow. SANDBOX: set the username
# to "sandbox" and the SDK auto-routes to api.sandbox.africastalking.com. CODE COMPLETE — real SMS
# not yet live-verified (pending: real Africa's Talking credentials). BOARD_NOTIFICATION_PHONE receives
# a summary of every vet-verification lookup / clinic KYC event: a minimal SMS stand-in for the
# board/reporting layer (not yet built), not the real thing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
BOARD_NOTIFICATION_PHONE=

# KYC document storage (PART 4). Real uploads go to Cloudflare R2 (S3-compatible) via boto3 when ALL
# four R2_* vars are set; otherwise the API falls back to LOCAL DISK (LOCAL_UPLOAD_DIR, served back
# at /uploads) so the local demo's document submission works with zero external credentials.
# CODE COMPLETE — not yet live-verified against a real R2 bucket (pending: R2 account/bucket/token).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public bucket URL (e.g. https://pub-XXXX.r2.dev). If unset, the object URL is built from
# the S3 endpoint + bucket.
R2_PUBLIC_BASE_URL=
LOCAL_UPLOAD_DIR=uploads
# Max accepted KYC file size in MB (images PNG/JPEG/WebP + PDF allowed).
DOC_UPLOAD_MAX_MB=10